<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Filter</key>
	<dict>
		<key>Mode</key>
		<string>AnyApplication</string>
		<key>Bundles</key>
		<array>
			<!-- AnyApplication 已覆盖所有 App（含微信等三方 App）；
			     额外保留 springboard，确保主屏幕/Spotlight 调出的键盘也注入。
			     注意：绝不注入 com.apple.Preferences —— 设置进程跑 UIKeyboard* hook 会触发
			     点击设置入口的 watchdog 重启；该保护改由 Tweak.xm 的 %group KBP + %ctor 守卫实现。 -->
			<string>com.apple.springboard</string>
		</array>
	</dict>
</dict>
</plist>
